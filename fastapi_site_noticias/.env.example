# Copie para .env e preencha. Nunca publique o .env.
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=SiteNoticias
DB_USER=USUARIO_SQL_DA_API
DB_PASSWORD=COLOQUE_A_SENHA_AQUI
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Durante testes locais, ajuste para a origem do frontend.
# Em produção, use o domínio real do portal.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
